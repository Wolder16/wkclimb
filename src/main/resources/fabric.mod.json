{
  "schemaVersion": 1,
  "id": "wkclimb",
  "version": "${version}",
  "name": "wkclimb",
  "description": "Adds climbing mechanics from White Knuckle (grip anchors, two hands, sphere constraints).",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/Wolder16/wkclimb"
  },
  "license": "CC0-1.0",
  "icon": "assets/wkclimb/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "div.wkclimb.WKClimb"
    ],
    "client": [
      "div.wkclimb.client.WKClimbClient"
    ],
    "cardinal-components": [
      "div.wkclimb.components.ClimberComponents"
    ]
  },
  "mixins": [
    "wkclimb.mixins.json",
    {
      "config": "wkclimb.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*",
    "cardinal-components-base": ">=6.1.3",
    "cardinal-components-entity": ">=6.1.3"
  },
  "custom": {
    "cardinal-components": [
      "wkclimb:climber"
    ]
  }
}
